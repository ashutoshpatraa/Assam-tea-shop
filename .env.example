# Copy to .env. Keep real credentials out of source control.
DATABASE_URL="file:../dev.db"

# Server-only merchant payment details. Orders cannot accept payment until configured.
UPI_ID=""
UPI_PAYEE_NAME="Assam Tea Shop"

# Generate a bcrypt hash with `npm run admin:hash`.
ADMIN_EMAIL=""
ADMIN_PASSWORD_HASH=""
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=""

APP_BASE_URL="http://localhost:3000"
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_BYTES="5242880"
SEED_STARTER_DATA="true"
